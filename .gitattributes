* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cff text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.parquet binary
*.npz binary
*.npy binary
*.safetensors binary
*.tar.gz binary

# The split manifest and the inventory are data, not prose; keep them out of linguist stats.
runs/**/splits/manifest.json linguist-generated=true
datasets/inventory/*.md linguist-documentation=true

*.pdf binary

# Raw pwc responses are hashed byte-for-byte in the ledger; git must not rewrite their line endings.
runs/**/paper_lookups/*.json -text
# The split manifest is hashed byte-for-byte in the split_build / split_rebuild entries.
runs/**/splits/manifest.json -text
# A gate receipt hashes harness.json as written (CRLF on Windows) in its inputs; keep the bytes the receipt saw.
runs/**/harness.json -text
# New execution-contract artifacts are hashed as persisted bytes, not normalized text.
runs/**/hosts/** -text
runs/**/execution/*.json -text
runs/**/failures/*.json -text
# The tensor inventory is hashed as stored bytes by its ledger entry.
runs/**/tensor_inventory.json -text
# Off-run consultation and audit manifests are hashed as written bytes.
docs/protocol/**/metadata.json -text
docs/protocol/**/paper_lookups/*.json -text
docs/protocol/**/lookup_manifest.json -text
docs/protocol/**/receipt_integrity.json -text
docs/protocol/**/text_redactions.json -text
docs/protocol/**/text_cleanup_verification.json -text
docs/protocol/**/prompt_redaction.json -text
docs/protocol/**/*.metadata.json -text
